{
  "expo": {
    "name": "Klearn",
    "slug": "klearn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/klearn-icon.png",
    "scheme": "klearn",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/klearn-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F7F2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.klearn",
      "buildNumber": "1",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Klearn uses your microphone for Korean speaking and pronunciation practice."
      }
    },
    "android": {
      "package": "com.klearn",
      "versionCode": 1,
      "permissions": [
        "POST_NOTIFICATIONS",
        "RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F8F7F2",
        "foregroundImage": "./assets/klearn-icon.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "edgeToEdgeEnabled": true,
      "navigationBar": {
        "visible": "always",
        "backgroundColor": "#EEEEE6"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./app"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/klearn-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F8F7F2",
          "dark": {
            "image": "./assets/klearn-icon.png",
            "backgroundColor": "#151C1A"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/klearn-icon.png",
          "color": "#176B55"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow Klearn to access your microphone for Korean speaking and pronunciation practice."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
