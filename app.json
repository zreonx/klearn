{
  "expo": {
    "name": "Klearn",
    "slug": "klearn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/klearn-icon.png",
    "scheme": "klearn",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zrodayrit.klearn",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.zrodayrit.klearn",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#176B55",
        "foregroundImage": "./assets/klearn-icon.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "edgeToEdgeEnabled": true,
      "navigationBar": {
        "visible": "always",
        "backgroundColor": "#EEEEE6"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/klearn-faviicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./app"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
