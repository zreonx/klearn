{
  "expo": {
    "name": "Klearn",
    "slug": "klearn",
    "version": "1.1.2",
    "orientation": "portrait",
    "icon": "./assets/klearn-android-foreground.png",
    "scheme": "klearn",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.klearn",
      "buildNumber": "4",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Klearn uses your microphone for Korean speaking and pronunciation practice."
      }
    },
    "android": {
      "package": "com.klearn",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#F8F7F2",
        "foregroundImage": "./assets/klearn-android-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./app"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/klearn-android-foreground.png",
          "resizeMode": "contain",
          "backgroundColor": "#F8F7F2",
          "dark": {
            "image": "./assets/klearn-android-foreground.png",
            "backgroundColor": "#151C1A"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
